# Copy to .env and adjust. Every setting is optional; defaults are shown.
# See docs/configuration.md for details.

# --- General ---
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API cross-origin. Empty = same-origin only.
CORS_ORIGINS=

# --- Limits ---
MAX_UPLOAD_MB=50
MAX_LINES=200000
MAX_CONCURRENT_JOBS=2

# --- Ollama (local LLMs) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_MODELS=llama3.2:1b,gemma4:12b,qwen2.5:0.5b
DEFAULT_MODEL=llama3.2:1b

# --- Gemini (cloud LLMs) ---
# Optional server-side key. Users can also enter their own key in the UI.
GOOGLE_API_KEY=
GEMINI_MAX_RPM=15
GEMINI_BURST=1
GEMINI_COOLDOWN_SECONDS=15
GEMINI_MAX_RETRIES=5
GEMINI_BASE_DELAY=2.0
GEMINI_MAX_DELAY=30.0
GEMINI_CACHE_TTL=300
GEMINI_TIMEOUT=60
GEMINI_MAX_CONCURRENCY=2

# --- ML pre-filter ---
PREFILTER_MIN_LINES=50
PREFILTER_PERCENTILE=85
PREFILTER_MAP_SIZE=12
PREFILTER_SEED=42

# --- Misc ---
ENABLE_GPU_STATUS=true
